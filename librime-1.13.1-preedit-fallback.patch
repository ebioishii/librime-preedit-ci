 namespace rime {
 
-Menu::Menu() : merged_(new MergedTranslation(candidates_)), result_(merged_) {}
+namespace {
+
+// Keep display data in the existing heap allocation, preserving Menu's ABI.
+class MenuTranslation : public MergedTranslation {
+ public:
+  explicit MenuTranslation(const CandidateList& candidates)
+      : MergedTranslation(candidates) {}
+
+  string fallback_preedit;
+};
+
+}  // namespace
+
+Menu::Menu() : merged_(new MenuTranslation(candidates_)), result_(merged_) {}
+
+void Menu::SetFallbackPreedit(const string& preedit) {
+  static_cast<MenuTranslation&>(*merged_).fallback_preedit = preedit;
+}
+
+const string& Menu::GetFallbackPreedit() const {
+  return static_cast<const MenuTranslation&>(*merged_).fallback_preedit;
+}
 
 void Menu::AddTranslation(an<Translation> translation) {
   *merged_ += translation;
