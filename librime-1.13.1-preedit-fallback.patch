diff --git a/test/composition_test.cc b/test/composition_test.cc
new file mode 100644
index 0000000..e6cc2de
--- /dev/null
+++ b/test/composition_test.cc
@@ -0,0 +1,199 @@
+//
+// Copyright RIME Developers
+// Distributed under the BSD License
+//
+
+#include <gtest/gtest.h>
+#include <rime/composition.h>
+#include <rime/context.h>
+#include <rime/dict/dict_compiler.h>
+#include <rime/dict/dictionary.h>
+#include <rime/engine.h>
+#include <rime/key_event.h>
+#include <rime/menu.h>
+#include <rime/schema.h>
+
+using namespace rime;
+
+namespace {
+
+const string kSh = "\xe3\x84\x95";
+const string kU = "\xe3\x84\xa8";
+const string kR = "\xe3\x84\x96";
+const string kZhuyin = kSh + kU + kR;
+
+the<Engine> CreatePreeditEngine(bool format = true) {
+  auto config = new Config;
+  auto processors = New<ConfigList>();
+  processors->Append(New<ConfigValue>("speller"));
+  config->SetItem("engine/processors", processors);
+  auto segmentors = New<ConfigList>();
+  segmentors->Append(New<ConfigValue>("abc_segmentor"));
+  config->SetItem("engine/segmentors", segmentors);
+  auto translators = New<ConfigList>();
+  translators->Append(New<ConfigValue>("script_translator"));
+  config->SetItem("engine/translators", translators);
+  config->SetString("translator/dictionary", "dictionary_test");
+  config->SetItem("translator/enable_user_dict", New<ConfigValue>(false));
+  config->SetItem("translator/enable_completion", New<ConfigValue>(false));
+  if (format) {
+    // Test-only display rule. Use the existing pinyin dictionary unchanged:
+    // gjb has no match, while shuru still has real dictionary candidates.
+    auto rules = New<ConfigList>();
+    rules->Append(New<ConfigValue>("xlit/gjb/" + kZhuyin + "/"));
+    config->SetItem("translator/preedit_format", rules);
+  }
+  the<Engine> engine(Engine::Create());
+  engine->ApplySchema(new Schema("preedit_test", config));
+  return engine;
+}
+
+bool Type(Engine* engine, const string& input) {
+  for (unsigned char ch : input) {
+    if (!engine->ProcessKey(KeyEvent(ch, 0)))
+      return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+class PreeditInputTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    // Reuse the repository's real dictionary fixture and existing compiler.
+    // Generated dictionary binaries stay in the test working directory.
+    if (!dictionary_ready_) {
+      Dictionary dictionary(
+          "dictionary_test", {},
+          {New<Table>(path{"dictionary_test.table.bin"})},
+          New<Prism>(path{"dictionary_test.prism.bin"}));
+      DictCompiler compiler(&dictionary);
+      ASSERT_TRUE(compiler.Compile(path()));
+      dictionary_ready_ = true;
+    }
+    engine_ = CreatePreeditEngine();
+  }
+
+  inline static bool dictionary_ready_ = false;
+  the<Engine> engine_;
+};
+
+TEST_F(PreeditInputTest, QueryFormatsWithoutProducingACandidate) {
+  ASSERT_TRUE(Type(engine_.get(), "gjb"));
+  auto ctx = engine_->context();
+  ASSERT_EQ(1U, ctx->composition().size());
+  const Segment& segment = ctx->composition().back();
+  ASSERT_TRUE(segment.menu);
+  EXPECT_EQ(kZhuyin, segment.menu->GetFallbackPreedit());
+  EXPECT_FALSE(ctx->HasMenu());
+  EXPECT_EQ(0U, segment.menu->Prepare(1));
+  EXPECT_EQ(0U, segment.start);
+  EXPECT_EQ(3U, segment.end);
+  const Preedit preedit = ctx->GetPreedit();
+  EXPECT_EQ(kZhuyin, preedit.text);
+  EXPECT_EQ(0U, preedit.sel_start);
+  EXPECT_EQ(9U, preedit.sel_end);
+  EXPECT_EQ(9U, preedit.caret_pos);
+  EXPECT_EQ("gjb", ctx->input());
+  EXPECT_EQ("gjb", ctx->GetCommitText());
+
+  string committed;
+  auto connection = engine_->sink().connect(
+      [&](const string& text) { committed = text; });
+  EXPECT_TRUE(ctx->Commit());
+  EXPECT_EQ("gjb", committed);
+  connection.disconnect();
+  ASSERT_TRUE(Type(engine_.get(), "jb"));
+  EXPECT_EQ(kU + kR, ctx->GetPreedit().text);
+}
+
+TEST_F(PreeditInputTest, MiddleCaretUsesDisplayedByteBoundaries) {
+  ASSERT_TRUE(Type(engine_.get(), "gjb"));
+  auto baseline = CreatePreeditEngine(false);
+  ASSERT_TRUE(Type(baseline.get(), "gjb"));
+  auto ctx = engine_->context();
+  const string expected[] = {kZhuyin, kSh + "jb", kSh + kU + "b", kZhuyin};
+  const size_t byte_pos[] = {0, 3, 6, 9};
+  const size_t sel_end[] = {9, 3, 6, 9};
+  for (size_t pos = 0; pos <= 3; ++pos) {
+    SCOPED_TRACE(pos);
+    ctx->set_caret_pos(pos);  // recomposes through ScriptTranslator::Query()
+    baseline->context()->set_caret_pos(pos);
+    EXPECT_FALSE(ctx->HasMenu());
+    const Preedit preedit = ctx->GetPreedit();
+    EXPECT_EQ(expected[pos], preedit.text);
+    EXPECT_EQ(byte_pos[pos], preedit.caret_pos);
+    EXPECT_EQ(0U, preedit.sel_start);
+    EXPECT_EQ(sel_end[pos], preedit.sel_end);
+    EXPECT_EQ(pos, ctx->caret_pos());
+    EXPECT_EQ("gjb", ctx->input());
+    EXPECT_EQ(baseline->context()->GetCommitText(), ctx->GetCommitText());
+    EXPECT_EQ(pos == 0 ? 3U : pos, ctx->composition().back().end);
+  }
+  ctx->set_option("soft_cursor", true);
+  ctx->set_caret_pos(2);
+  const Preedit preedit = ctx->GetPreedit();
+  EXPECT_EQ(kSh + kU + "\xe2\x80\xb8" + "b", preedit.text);
+  EXPECT_EQ(6U, preedit.caret_pos);
+  EXPECT_EQ(6U, preedit.sel_end);
+}
+
+TEST_F(PreeditInputTest, ConvertedPrefixDoesNotShiftInputIndices) {
+  ASSERT_TRUE(Type(engine_.get(), "shuru"));
+  auto ctx = engine_->context();
+  auto candidate = ctx->GetSelectedCandidate();
+  ASSERT_TRUE(candidate);
+  ASSERT_EQ(5U, candidate->end());
+  const string converted = candidate->text();
+  ASSERT_TRUE(ctx->ConfirmCurrentSelection());
+  ASSERT_TRUE(Type(engine_.get(), "gjb"));
+  EXPECT_FALSE(ctx->HasMenu());
+  auto preedit = ctx->GetPreedit();
+  EXPECT_EQ(converted + kZhuyin, preedit.text);
+  EXPECT_EQ(converted.length(), preedit.sel_start);
+  EXPECT_EQ(converted.length() + 9, preedit.sel_end);
+  EXPECT_EQ(converted.length() + 9, preedit.caret_pos);
+
+  ctx->set_caret_pos(7);
+  preedit = ctx->GetPreedit();
+  EXPECT_EQ(converted + kSh + kU + "b", preedit.text);
+  EXPECT_EQ(converted.length(), preedit.sel_start);
+  EXPECT_EQ(converted.length() + 6, preedit.sel_end);
+  EXPECT_EQ(converted.length() + 6, preedit.caret_pos);
+  EXPECT_EQ(5U, ctx->composition().back().start);
+  EXPECT_EQ(7U, ctx->composition().back().end);
+  EXPECT_EQ("shurugjb", ctx->input());
+  EXPECT_EQ(converted + "gj", ctx->GetCommitText());
+}
+
+TEST_F(PreeditInputTest, CandidatesAndUnformattedSchemaRemainUnchanged) {
+  auto baseline = CreatePreeditEngine(false);
+  ASSERT_TRUE(Type(baseline.get(), "gjb"));
+  EXPECT_FALSE(baseline->context()->HasMenu());
+  EXPECT_EQ("gjb", baseline->context()->GetPreedit().text);
+  baseline->context()->Clear();
+
+  ASSERT_TRUE(Type(engine_.get(), "shuru"));
+  ASSERT_TRUE(Type(baseline.get(), "shuru"));
+  ASSERT_TRUE(engine_->context()->HasMenu());
+  ASSERT_TRUE(baseline->context()->HasMenu());
+  the<Page> formatted(
+      engine_->context()->composition().back().menu->CreatePage(128, 0));
+  the<Page> original(
+      baseline->context()->composition().back().menu->CreatePage(128, 0));
+  ASSERT_TRUE(formatted);
+  ASSERT_TRUE(original);
+  ASSERT_EQ(original->candidates.size(), formatted->candidates.size());
+  bool found_input = false;
+  for (size_t i = 0; i < original->candidates.size(); ++i) {
+    EXPECT_EQ(original->candidates[i]->text(), formatted->candidates[i]->text());
+    EXPECT_EQ(original->candidates[i]->preedit(),
+              formatted->candidates[i]->preedit());
+    if (formatted->candidates[i]->text() == "\xe8\xbe\x93\xe5\x85\xa5")
+      found_input = true;  // existing fixture entry: simplified Chinese input
+  }
+  EXPECT_TRUE(found_input);
+  EXPECT_EQ(baseline->context()->GetCommitText(),
+            engine_->context()->GetCommitText());
+}
